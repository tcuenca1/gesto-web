{
  "info": {
    "name": "GestoWeb API",
    "description": "Colección para probar la API de GestoWeb sin el frontend (SRS §8.2). Ejecuta primero «Iniciar sesión»: guarda el token automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idSesion",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrarse",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/registro",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de Postman\",\n  \"correo\": \"postman@gestoweb.local\",\n  \"contrasena\": \"Postman123\"\n}"
            }
          }
        },
        {
          "name": "Iniciar sesión (admin de prueba)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gestoweb.local\",\n  \"contrasena\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('token', d.token);",
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud del servidor",
          "request": {
            "method": "GET",
