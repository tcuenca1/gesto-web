# =====================================================================
# Variables de entorno del backend de GestoWeb
# Copia este archivo como ".env" y ajusta los valores.
# El archivo .env real NUNCA se sube a Git (está en .gitignore).
# =====================================================================

# Puerto del servidor
PUERTO=3000

# "postgres" (normal) o "memoria" (sin base de datos; los datos se pierden al reiniciar)
REPOSITORIOS=postgres

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestoweb
# true si el proveedor en la nube exige SSL (Railway, Render, Neon…)
PGSSL=false

# Secreto para firmar los tokens JWT. En producción: 32 caracteres o más, aleatorio.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración del token (RNF-07: 8 horas)
JWT_EXPIRACION=8h

# Orígenes que pueden llamar a la API (separados por coma)
CORS_ORIGENES=http://localhost:4200

# Zona horaria para agrupar las estadísticas por día
ZONA_HORARIA=America/Guayaquil

# Opcional: carpeta del frontend compilado para servir todo desde un solo servidor
# CARPETA_FRONTEND=../frontend/dist/gestoweb/browser
